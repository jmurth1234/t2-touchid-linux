# Copy to /etc/t2-touchid.conf and keep it root-owned (0644 or stricter).
T2_TOUCHID_USER=your-linux-user
T2_TOUCHID_HOST=fe80::replace-with-the-t2-link-local-address
T2_TOUCHID_INTERFACE=replace-with-the-t2-usb-network-interface
T2_TOUCHID_PROJECT_DIR=/opt/t2-touchid
T2_TOUCHID_MACOS_USER_ID=501
T2_TOUCHID_SPECIAL_BAG=-501
T2_TOUCHID_ENROLLED_FINGER=right-index-finger
