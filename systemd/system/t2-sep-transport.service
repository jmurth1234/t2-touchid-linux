# SPDX-License-Identifier: GPL-2.0-only
[Unit]
Description=Apple T2 SEP transport for Touch ID research
After=local-fs.target
ConditionPathExists=/usr/local/sbin/t2-sep-transport-load

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/t2-sep-transport-load
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
