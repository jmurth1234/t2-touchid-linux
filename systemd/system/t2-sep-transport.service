# SPDX-License-Identifier: GPL-2.0-only
[Unit]
Description=Apple T2 SEP transport for Touch ID research
After=local-fs.target t2-biometric-port-refresh.service
ConditionPathExists=/usr/local/sbin/t2-sep-transport-load

[Service]
Type=oneshot
ExecStartPre=/usr/bin/sleep 5
ExecStart=/usr/local/sbin/t2-sep-transport-load
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
