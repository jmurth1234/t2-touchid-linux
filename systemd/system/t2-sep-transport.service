[Unit]
Description=Apple T2 SEP transport for Touch ID research
After=local-fs.target
ConditionPathExists=/usr/local/lib/t2-touchid/t2_sep_transport.ko

[Service]
Type=oneshot
ExecStart=/usr/bin/insmod /usr/local/lib/t2-touchid/t2_sep_transport.ko register_ool=1
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
