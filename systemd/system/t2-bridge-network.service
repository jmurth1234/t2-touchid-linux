[Unit]
Description=Prepare the private Apple T2 BridgeOS network
After=NetworkManager.service
Before=network-online.target t2-biometric-port-refresh.service
ConditionPathExists=/etc/t2-touchid.conf

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/t2-bridge-network-prepare
ExecStop=/usr/local/sbin/t2-bridge-network-prepare restore
RemainAfterExit=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ReadWritePaths=/sys/bus/usb/drivers
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectKernelModules=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET6
RestrictNamespaces=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
SystemCallFilter=@system-service
