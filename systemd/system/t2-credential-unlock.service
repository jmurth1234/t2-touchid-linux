[Unit]
Description=Unlock Apple T2 keybags from an encrypted system credential
Requires=t2-keybag-load.service
After=t2-keybag-load.service
ConditionPathExists=/etc/credstore.encrypted/t2-touchid-password

[Service]
Type=oneshot
LoadCredentialEncrypted=t2-touchid-password:/etc/credstore.encrypted/t2-touchid-password
ExecStart=/usr/local/sbin/t2-credential-unlock
RemainAfterExit=yes
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectKernelModules=yes

[Install]
WantedBy=multi-user.target
