# SPDX-License-Identifier: GPL-2.0-only
[Unit]
Description=Warm up Apple T2 BiometricKit before exposing fprintd
Requires=t2-credential-unlock.service
After=t2-credential-unlock.service NetworkManager.service network-online.target
Wants=network-online.target
ConditionPathExists=/etc/credstore.encrypted/t2-touchid-password

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/t2-biometric-ready
RemainAfterExit=yes
StateDirectory=t2-touchid
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectKernelModules=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_LOCAL AF_NETLINK AF_INET6
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
